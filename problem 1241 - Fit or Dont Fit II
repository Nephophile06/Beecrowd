#include <iostream>
#include <string>
using namespace std;

int main() 
{
    int n;
    cin >> n; 

    for (int i = 0; i < n; i++) 
    {
        string a, b;
        cin >> a >> b; 
        
        if (a.size() >= b.size() && a.substr(a.size() - b.size()) == b) 
            cout << "encaixa" << endl;
        else 
            cout << "nao encaixa" << endl;
    }

    return 0;
}
