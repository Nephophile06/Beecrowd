#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int N;
    cin >> N;

    vector<int> fact;
    fact.push_back(1);

    for (int i = 2; ; i++) 
    {
        long long f = 1;
        for (int j = 1; j <= i; j++) 
            f *= j;
        if (f > 100000) 
            break;
        fact.push_back(f);
    }

    int cnt = 0;
    for (int i = fact.size() - 1; i >= 0; i--) 
    {
        while (N >= fact[i]) 
        {
            N -= fact[i];
            cnt++;
        }
    }

    cout << cnt << "\n";
    return 0;
}
