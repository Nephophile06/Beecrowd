#include <iostream>
using namespace std;

int num_calls = 0;

int fib(int n) 
{
    num_calls++;
    if (n == 0) 
        return 0;
    if (n == 1) 
        return 1;

    return fib(n-1) + fib(n-2);
}

int main() 
{
    int T; 
    cin >> T;

    while (T--) 
    {
        int X; 
        cin >> X;
        num_calls = 0;
        int result = fib(X);
        cout << "fib(" << X << ") = " << num_calls-1 << " calls = " << result << endl;
    }

    return 0;
}
