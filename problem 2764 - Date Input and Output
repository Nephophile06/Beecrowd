#include <iostream>
#include <iomanip>
using namespace std;

int main() 
{
    int d, m, y;
    char slash; 
    
    while (cin >> d >> slash >> m >> slash >> y) 
    {
        cout << setw(2) << setfill('0') << m << "/" 
             << setw(2) << setfill('0') << d << "/" 
             << setw(2) << setfill('0') << y << "\n";

        cout << setw(2) << setfill('0') << y << "/" 
             << setw(2) << setfill('0') << m << "/" 
             << setw(2) << setfill('0') << d << "\n";

        cout << setw(2) << setfill('0') << d << "-" 
             << setw(2) << setfill('0') << m << "-" 
             << setw(2) << setfill('0') << y << "\n";
    }

    return 0;
}
