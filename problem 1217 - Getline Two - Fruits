#include <iostream>
#include <iomanip>
#include <string>
#include <sstream>
using namespace std;

int main() 
{
    int N;
    cin >> N;
    cin.ignore();

    double totalMoney = 0.0;
    int totalKg = 0;

    for (int i = 0; i < N; i++) 
    {
        double moneySpent;
        cin >> moneySpent;
        cin.ignore();
        totalMoney += moneySpent;

        string fruitsLine;
        getline(cin, fruitsLine);
        istringstream iss(fruitsLine);
        string fruit;
        int kgPerDay = 0;

        while (iss >> fruit) 
        {
            kgPerDay++;
        }

        totalKg += kgPerDay;
        cout << "day " << i + 1 << ": " << kgPerDay << " kg" << endl;
    }

    double avgKg = static_cast<double>(totalKg) / N;
    double avgMoney = totalMoney / N;

    cout << fixed << setprecision(2);
    cout << avgKg << " kg by day" << endl;
    cout << "R$ " << avgMoney << " by day" << endl;

    return 0;
}
