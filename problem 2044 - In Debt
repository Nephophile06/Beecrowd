#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int N;
    while (cin >> N && N != -1) 
    {
        vector<int> P(N);
        for (int i = 0; i < N; i++) 
            cin >> P[i];

        int debt = 0, visits = 0;
        for (int i = 0; i < N; i++) {
            debt += P[i];
            if (debt % 100 == 0) {
                visits++;
                debt = 0; 
            }
        }

        cout << visits << "\n";
    }
    
    return 0;
}
