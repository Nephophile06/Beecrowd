#include <iostream>
#include <string>
using namespace std;
 
int LuckyNumber(int num) 
{
    while (num > 9) 
    {
        int sum = 0;
        while (num > 0) 
        {
            sum += num % 10;
            num /= 10;
        }
        num = sum;
    }
    return num;
}

int main() 
{
    string name;
    while (getline(cin, name)) 
    {
        int total = 0;
        for (char c : name) 
        {
            if (isalpha(c)) 
            {
                char lowerC = tolower(c);
                total += (lowerC - 'a' + 1);
            }
        }
 
        int num = LuckyNumber(total); 
        cout << num << endl;
    }
    return 0;
}
