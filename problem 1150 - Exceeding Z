#include <iostream>
using namespace std;

int main() 
{
    int X, Z;
    cin >> X;

    do {
        cin >> Z;
    } while (Z <= X);

    int sum = 0, count = 0, current = X;
    while (sum <= Z) 
    {
        sum += current;
        current++;
        count++;
    }

    cout << count << endl;

    return 0;
}
