#include <iostream>
#include <iomanip>
using namespace std;

int main() 
{
    float A, B;       
    double C, D;      

    while (cin >> A >> B >> C >> D) 
    { 
        cout << "A = " << fixed << setprecision(6) << A << ", B = " << B << endl;
        cout << "C = " << C << ", D = " << D << endl;
 
        cout << fixed << setprecision(1);
        cout << "A = " << A << ", B = " << B << endl;
        cout << "C = " << C << ", D = " << D << endl;
 
        cout << fixed << setprecision(2);
        cout << "A = " << A << ", B = " << B << endl;
        cout << "C = " << C << ", D = " << D << endl;
 
        cout << fixed << setprecision(3);
        cout << "A = " << A << ", B = " << B << endl;
        cout << "C = " << C << ", D = " << D << endl;
 
        cout << scientific << uppercase << setprecision(3);
        cout << "A = " << A << ", B = " << B << endl;
        cout << "C = " << C << ", D = " << D << endl;
 
        cout << fixed << setprecision(0);
        cout << "A = " << A << ", B = " << B << endl;
        cout << "C = " << C << ", D = " << D << endl;
    }

    return 0;
}
