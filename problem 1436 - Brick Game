#include <iostream>
using namespace std;

int main() 
{
    int T;
    cin >> T;

    for (int t = 1; t <= T; ++t) 
    {
        int N; 
        cin >> N;

        int ages[10]; 
        for (int i = 0; i < N; ++i) 
        {
            cin >> ages[i];
        }

        int captainAge = ages[N / 2];
        cout << "Case " << t << ": " << captainAge << endl;
    }

    return 0;
}
