#include <iostream>
#include <string>
using namespace std;

int main() 
{
    string cpf;
    while (cin >> cpf) 
    {
        int b1 = 0, b2 = 0;

        for (int i = 0, j = 1, k = 9; i < 11; ++i) 
        {
            if (cpf[i] == '.' || cpf[i] == '-') 
                continue;

            int digit = cpf[i] - '0';
            if (j <= 9) 
                b1 += digit * j++;
            if (k >= 1) 
                b2 += digit * k--;
        }

        b1 %= 11;
        if (b1 == 10) 
            b1 = 0;

        b2 %= 11;
        if (b2 == 10) 
            b2 = 0;

        if (b1 == (cpf[12] - '0') && b2 == (cpf[13] - '0')) 
            cout << "CPF valido" << endl;
        else 
            cout << "CPF invalido" << endl;
    }
    return 0;
}
