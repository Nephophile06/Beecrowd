#include <iostream>
#include <string>
using namespace std;

int main() 
{
    int leds[10] = {6, 2, 5, 5, 4, 5, 6, 3, 7, 6};
    
    int N; 
    cin >> N;  
    
    for (int i = 0; i < N; i++) 
    {
        string V;
        cin >> V;  
        int total_leds = 0;
        
        for (char c : V) 
        {
            total_leds += leds[c - '0'];  
        }
        
        cout << total_leds << " leds" << endl;
    }

    return 0;
}
