#include <iostream>
#include <string>
using namespace std;

int main() 
{
    string a;
    while (cin >> a) 
    {
        int n;
        cin >> n;
        int x[n]; 
        for (int i = 0; i < n; i++) 
        {
            cin >> x[i]; 
        }

        string message;
        for (int i = 0; i < n; i++) 
        {
            message += a[x[i] - 1]; 
        }

        cout << message << endl; 
    }

    return 0;
}
