#include <iostream>
#include <string>
using namespace std;

int main() 
{
    int N;
    while (cin >> N && N != 0) 
    {
        string earliestPlanet;
        int minYear = 3000; 

        for (int i = 0; i < N; ++i) 
        {
            string planet;
            int A, T;
            cin >> planet >> A >> T;
            int sentYear = A - T;

            if (sentYear < minYear) 
            {
                minYear = sentYear;
                earliestPlanet = planet;
            }
        }
        
        cout << earliestPlanet << endl;
    }

    return 0;
}
