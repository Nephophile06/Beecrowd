#include <iostream>
using namespace std;

int main() 
{
    int N;
    cin >> N;

    while (N--) 
    {
        int K;
        cin >> K;
    
        for (int i = 0; i < K; ++i) 
        {
            int code;
            cin >> code;
        
            if (code == 1) 
                cout << "Rolien" << endl;
            else if (code == 2) 
                cout << "Naej" << endl;
            else if (code == 3) 
                cout << "Elehcim" << endl;
            else if (code == 4) 
                cout << "Odranoel" << endl;
        }
    }

    return 0;
}
