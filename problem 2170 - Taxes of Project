#include <iostream>
#include <iomanip>  
using namespace std;

int main() 
{
    double X, Y;
    int project_number = 1; 

    while (cin >> X >> Y) 
    {
        double rate = ((Y / X) - 1) * 100;
        cout << "Projeto " << project_number << ":" << endl;
        cout << "Percentual dos juros da aplicacao: " << fixed << setprecision(2) << rate << " %" << endl;
        cout << endl;  
        project_number++; 
    }
    
    return 0;
}
