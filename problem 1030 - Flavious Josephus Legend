#include <iostream>
using namespace std;

int main() 
{
    int NC; 
    cin >> NC;

    for (int caseNum = 1; caseNum <= NC; ++caseNum) 
    {
        int n, k;
        cin >> n >> k;

        int result = 0; 
        for (int i = 2; i <= n; ++i) 
        {
            result = (result + k) % i;
        }

        cout << "Case " << caseNum << ": " << result + 1 << endl; 
    }

    return 0;
}
