#include <iostream>
using namespace std;

int main() 
{
    int N;

    while (cin >> N && N != 0) 
    {
        for (int i = 0; i < N; i++) 
        {
            int values[5];
            for (int j = 0; j < 5; j++) 
            {
                cin >> values[j];
            }

            int countMarked = 0;     
            int markedIndex = -1;    
            
            for (int j = 0; j < 5; j++) 
            {
                if (values[j] <= 127) 
                {
                    countMarked++;
                    markedIndex = j; 
                }
            }

            if (countMarked == 1) 
            {
                char answer = 'A' + markedIndex;
                cout << answer << endl;
            } 
            
            else 
            {
                cout << "*" << endl;
            }
        }
    }

    return 0;
}
