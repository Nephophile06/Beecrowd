#include <iostream>
#include <string>
using namespace std;

int main() 
{
    string P;
    while (cin >> P) 
    {
        if (P == "-1") 
            break;
        
        if (P == "0") 
            cout << "0" << endl;
        else 
        {
            int len = P.length();
            int i = len - 1;

            while (i >= 0) 
            {
                if (P[i] > '0') 
                {
                    P[i]--;
                    break;
                } 
                
                else 
                {
                    P[i] = '9';
                    i--;
                }
            }

            if (P[0] == '0' && P.length() > 1) 
                P.erase(0, 1);

            cout << P << endl;
        }
    }
    return 0;
}
