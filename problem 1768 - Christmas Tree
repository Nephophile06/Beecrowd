#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int N;
    while (cin >> N) 
    {
        for (int i = 1; i <= N; i += 2) {
            int spaces = (N - i) / 2;
            cout << string(spaces, ' ') << string(i, '*') << endl;
        }

        int spaces_trunk2 = (N - 1) / 2;
        cout << string(spaces_trunk2, ' ') << "*" << endl;
        int spaces_trunk1 = (N - 3) / 2;
        cout << string(spaces_trunk1, ' ') << "***" << endl;


        cout << endl;
    }
    
    return 0;
}
