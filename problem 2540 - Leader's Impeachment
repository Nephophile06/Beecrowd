#include <iostream>
using namespace std;

int main() 
{
    int N;
    while (cin >> N) 
    {
        int total = 0;
        for (int i = 0; i < N; ++i) 
        {
            int vote;
            cin >> vote;
            if (vote == 1) 
            {
                total++;
            }
        }
 
        if (total * 3 >= 2 * N) 
            cout << "impeachment" << endl;
        else 
            cout << "acusacao arquivada" << endl;
    }

    return 0;
}
