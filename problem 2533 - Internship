#include <iostream>
#include <iomanip>
using namespace std;

int main() 
{
    int M;

    while (cin >> M) 
    {
        double weightedSum = 0.0;
        int totalCredits = 0;

        for (int i = 0; i < M; ++i) 
        {
            int grade, credits;
            cin >> grade >> credits;

            weightedSum += grade * credits;
            totalCredits += credits;
        }

        double API = weightedSum / totalCredits;
        API = API / 100.00;
        cout << fixed << setprecision(4) << API << endl;
    }

    return 0;
}
