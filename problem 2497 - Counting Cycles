#include <iostream>
using namespace std;

int main() 
{
    int N;
    int testCase = 1;
    
    while (true) 
    {
        cin >> N;
        if (N == -1) 
            break;
        
        int cycles = N / 2;
        cout << "Experiment " << testCase << ": " << cycles << " full cycle(s)" << endl;
        testCase++;
    }
    
    return 0;
}
