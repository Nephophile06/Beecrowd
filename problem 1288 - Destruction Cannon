#include <iostream>
#include <algorithm>
using namespace std;

int main() 
{
    int T, N, X, Y, K, R;
    cin >> T;

    while (T--) 
    {
        cin >> N;
        int damage[51], weight[51], dp[101] = {0};

        for (int i = 0; i < N; i++)
            cin >> damage[i] >> weight[i];

        cin >> K >> R;
        for (int i = 0; i < N; i++) 
        {
            for (int j = K; j >= weight[i]; j--) 
            {
                dp[j] = max(dp[j], dp[j - weight[i]] + damage[i]);
            }
        }

        cout << (dp[K] >= R ? "Missao completada com sucesso" : "Falha na missao") << endl;
    }

    return 0;
}
