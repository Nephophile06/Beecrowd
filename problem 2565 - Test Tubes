#include <iostream>
#include <algorithm>
#include <cmath>
#include <iomanip>
using namespace std;

int main() 
{
    int N;
    double tubes[100];  

    while (cin >> N) 
    {  
        for (int i = 0; i < N; ++i) 
        {
            cin >> tubes[i]; 
        }

        sort(tubes, tubes + N); 
        double median;

        if (N % 2 == 0) 
            median = (tubes[N / 2 - 1] + tubes[N / 2]) / 2.0;
        else 
            median = tubes[N / 2];
         
        double total_cost = 0.0;
        for (int i = 0; i < N; ++i) 
        {
            total_cost += abs(tubes[i] - median);
        }
 
        cout << fixed << setprecision(2) << total_cost << endl;
    }

    return 0;
}
