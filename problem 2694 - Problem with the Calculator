#include <iostream>
#include <string>
using namespace std;

int main() 
{
    int N;
    cin >> N;

    while (N--) 
    {
        string line;
        cin >> line;

        int sum = 0, number = 0;

        for (char c : line) 
        {
            if (isdigit(c)) 
                number = number * 10 + (c - '0');
            else 
            {
                sum += number;
                number = 0;
            }
        }

        sum += number; 
        cout << sum << endl;
    }

    return 0;
}
