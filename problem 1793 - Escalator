#include <iostream>
#include <vector>
using namespace std;

int main() 
{
    while (true) 
    {
        int N;
        cin >> N;

        if (N == 0) 
            break;

        vector<bool> active_seconds(1001, false); 
        int t;

        for (int i = 0; i < N; ++i) 
        {
            cin >> t;
            for (int j = t; j < t + 10; ++j) 
            {
                active_seconds[j] = true;
            }
        }

        int active_count = 0;
        for (int i = 1; i <= 1000; ++i) 
        {
            if (active_seconds[i]) 
            {
                ++active_count;
            }
        }

        cout << active_count << endl;
    }

    return 0;
}
