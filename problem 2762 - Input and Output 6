#include <iostream>
#include <string>
using namespace std;

int main() 
{
    string number;
    cin >> number;
    size_t dotPosition = number.find('.');

    string integerPart = number.substr(0, dotPosition);
    string decimalPart = number.substr(dotPosition + 1);

    int decimalValue = stoi(decimalPart);
    int integerValue = stoi(integerPart);

    cout << decimalValue << "." << integerValue << endl;

    return 0;
}
